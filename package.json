{
  "name": "todokeep-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:api": "pnpm --filter todokeep-api dev",
    "dev:web": "pnpm --filter todokeep-nextjs dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r exec rm -rf node_modules dist .next"
  }
}
